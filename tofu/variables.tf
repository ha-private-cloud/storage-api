variable "kubeconfig_path" {
  description = "Path to the Talos cluster's kubeconfig, generated by the proxmox-tofu / talosctl bootstrap."
  type        = string
  default     = "../../proxmox-tofu/_out/kubeconfig"
}

variable "namespace" {
  description = "Namespace to install storage-api into. Must already exist (created by cluster-config)."
  type        = string
  default     = "storage-dev-priv"
}

variable "environment" {
  description = "Environment name; disables /docs in prd."
  type        = string
  default     = "dev"
}

variable "image_repository" {
  description = "Registry + repository for the storage-api image."
  type        = string
  default     = "registry.clusterkeep.dev.net/storage-api"
}

variable "image_tag" {
  description = "For dev/preview (image_tag_prefix != \"\"): fallback tag, used only if no pushed tag matches image_tag_prefix yet. For prd (image_tag_prefix == \"\"): leave blank to deploy the highest vX.Y.Z tag on GitHub; set it (e.g. -var image_tag=v1.6.0) to pin a release or roll back."
  type        = string
  default     = ""
}

variable "image_tag_prefix" {
  description = "Which branch's tag channel this environment tracks: \"DEV-\" or \"PREVIEW-\". \"\" (prd) deploys release tags instead - see image_tag."
  type        = string
  default     = "DEV-"
}

variable "image_pull_secret_name" {
  description = "Name of the imagePullSecret for the Nexus docker-hosted repo."
  type        = string
  default     = ""
}

variable "replica_count" {
  description = "storage-api replicas. Unlocked keys live in Redis and files on the shared volume, so any replica can serve any request."
  type        = number
  default     = 2
}

variable "auth_api_internal_url" {
  description = "In-cluster auth-api Service URL, used to check the session cookie on every request."
  type        = string
  default     = "http://auth-api.auth-dev-pub.svc.cluster.local"
}

variable "service_token" {
  description = "Shared secret storage-ui and clusterkeep-ui present to call storage-api. Must match their storage_api_token."
  type        = string
  sensitive   = true
}

variable "data_storage_size" {
  description = "Size of the shared volume holding every user's encrypted files."
  type        = string
  default     = "200Gi"
}

variable "default_quota_bytes" {
  description = "Storage allowance for each new user."
  type        = number
  default     = 21474836480
}

variable "postgres_image" {
  description = "Postgres image backing file and folder metadata and each user's locked keys."
  type        = string
  default     = "postgres:16"
}

variable "postgres_storage_size" {
  description = "Size of the PVC (nfs-csi StorageClass) Postgres stores storage-api's metadata on."
  type        = string
  default     = "5Gi"
}

variable "redis_image" {
  description = "Redis image holding unlocked keys per sign-in session. Losing it only means users sign in again."
  type        = string
  default     = "redis:7-alpine"
}

variable "redis_max_memory" {
  description = "maxmemory for Redis."
  type        = string
  default     = "128mb"
}
